app-notifications = no-config-reload, clipboard-copy
bell-features = no-title,border
clipboard-read = allow
clipboard-write = allow
copy-on-select = both
cursor-style-blink = true
drag-handle = always
faint-opacity = 0.70
font-family = MonaspiceXe Nerd Font
font-size = 14
gtk-tabs-location = top
gtk-titlebar = true
gtk-toolbar-style = raised-border
gtk-wide-tabs = true
middle-click-action = clipboard-paste
minimum-contrast = 3.0
notify-on-command-finish = unfocused
palette-generate = true
palette-harmonious = true
quick-terminal-autohide = true
shell-integration = none
shell-integration-features = sudo, no-ssh-terminfo, no-ssh-env
split-inherit-working-directory = true
tab-inherit-working-directory = false
theme = light:tinted-light,dark:tinted-dark
unfocused-split-opacity = 0.90
window-decoration = client
window-inherit-working-directory = false
window-padding-balance = false
window-padding-color = extend
window-padding-x = 4
window-padding-y = 0,4
window-theme = ghostty
working-directory = home

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right

keybind = ctrl+g>h=goto_split:left
keybind = ctrl+g>j=goto_split:bottom
keybind = ctrl+g>k=goto_split:top
keybind = ctrl+g>l=goto_split:right
keybind = ctrl+g>shift+h=resize_split:left,50
keybind = ctrl+g>shift+j=resize_split:down,50
keybind = ctrl+g>shift+k=resize_split:up,50
keybind = ctrl+g>shift+l=resize_split:right,50
keybind = ctrl+g>shift+5=new_split:right
keybind = ctrl+g>shift+apostrophe=new_split:down
keybind = ctrl+g>z=toggle_split_zoom
keybind = ctrl+g>x=close_surface
keybind = ctrl+g>c=new_tab
keybind = ctrl+g>n=next_tab
keybind = ctrl+g>p=previous_tab
